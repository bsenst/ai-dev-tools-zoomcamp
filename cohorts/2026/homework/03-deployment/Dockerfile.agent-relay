FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir \
    "fastapi>=0.141.1" \
    "psycopg[binary]>=3.3.5" \
    "pydantic-settings>=2.15.0" \
    "sqlalchemy>=2.0.52" \
    "uvicorn[standard]>=0.52.4"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]